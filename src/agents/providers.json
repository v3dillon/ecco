  "opencode": {
    "help": [
      "run",
      "--help"
    ],
    "required": [
      "--pure",
      "--format",
      "--dir",
      "--agent",
      "--file"
    ],
    "keys": [
      "OPENCODE_CONFIG_DIR",
      "OPENCODE_DATA_DIR"
    ],
    "ready": [
      "auth",
      "list"
    ],
    "argv": [
      "@@agent@@",
      "run",
      "--pure",
      "--format",
      "json",
      "--dir",
      "@@workdir@@",
      "--agent",
      "ecco-dispatcher",
      "--file",
      "@@temp@@/request.txt",
      "Answer the attached Ecco request under the dispatcher rules."
    ],
    "input": null,
    "env": {
      "OPENCODE_CONFIG_CONTENT": "{\"plugin\":[],\"mcp\":{},\"agent\":{\"ecco-dispatcher\":{\"mode\":\"primary\",\"description\":\"Read-only Ecco request handler\",\"permission\":{\"*\":\"deny\",\"external_directory\":\"deny\",\"read\":\"allow\",\"grep\":\"allow\",\"glob\":\"allow\",\"list\":\"allow\"}}}}"
    },
    "files": {
      "request.txt": "@@prompt@@"
    },
    "modelKeys": true
  },
  "pi": {
