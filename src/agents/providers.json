  "openclaw": {
    "help": [
      "agent",
      "exec",
      "--help"
    ],
    "required": [
      "--message-file",
      "--cwd",
      "--config",
      "--code-mode",
      "--json"
    ],
    "keys": [
      "OPENCLAW_HOME",
      "OPENCLAW_CONFIG_PATH"
    ],
    "ready": [
      "doctor"
    ],
    "argv": [
      "@@agent@@",
      "agent",
      "exec",
      "--message-file",
      "-",
      "--cwd",
      "@@workdir@@",
      "--config",
      "@@temp@@/openclaw.json",
      "--code-mode",
      "direct",
      "--json"
    ],
    "input": "@@prompt@@",
    "env": {
      "OPENCLAW_INCLUDE_ROOTS": "@@openclaw_include@@"
    },
    "files": {
      "openclaw.json": "{\"$include\":\"@@openclaw_config@@\",\"agents\":{\"defaults\":{\"sandbox\":{\"mode\":\"all\",\"workspaceAccess\":\"ro\"}}},\"tools\":{\"profile\":\"minimal\",\"allow\":[\"read\"],\"deny\":[\"group:runtime\",\"group:web\",\"group:sessions\",\"group:memory\",\"group:messaging\",\"group:plugins\",\"write\",\"edit\",\"apply_patch\",\"skill_workshop\",\"mcp__*\"],\"fs\":{\"workspaceOnly\":true},\"elevated\":{\"enabled\":false}}}"
    },
    "modelKeys": true
  },
