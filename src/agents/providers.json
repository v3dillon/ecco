      "cli-config.json": "{\"version\":1,\"editor\":{\"vimMode\":false},\"permissions\":{\"allow\":[],\"deny\":[\"Shell(*)\",\"Read(**)\",\"Write(**)\",\"WebFetch(*)\",\"Mcp(*:*)\"]},\"approvalMode\":\"allowlist\"}"
    }
  },
  "grok": {
    "help": [
      "--help"
    ],
    "required": [
      "--cwd",
      "--output-format",
      "--json-schema",
      "--tools",
      "--disallowed-tools",
      "--no-subagents",
      "--disable-web-search",
      "--deny",
      "--permission-mode",
      "--sandbox",
      "--max-turns",
      "--prompt-file",
      "--verbatim"
    ],
    "keys": [
      "XAI_API_KEY"
    ],
    "ready": [
      "models"
    ],
    "argv": [
      "@@agent@@",
      "--prompt-file",
      "@@temp@@/prompt.txt",
      "--cwd",
      "@@workdir@@",
      "--output-format",
      "json",
      "--json-schema",
      "@@schema@@",
      "--tools",
      "read_file,grep,list_dir",
