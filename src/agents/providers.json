      "Answer the Ecco request contained in the private agent instructions.",
      "--output-format",
      "stream-json",
      "--final-message-only"
    ],
    "input": null,
    "env": {
      "KIMI_CODE_EXPERIMENTAL_FLAG": "1",
      "KIMI_TELEMETRY_ENABLED": "false"
    },
    "files": {
      "kimi-agent.md": "---\nname: ecco-dispatcher\ndescription: Read-only Ecco request handler\ntools: []\ndisallowedTools: [Read, Grep, Glob, Write, Edit, Bash, WebSearch, WebFetch, Agent, AgentSwarm, Task, Skill, AskUserQuestion]\nsubagents: []\n---\n@@prompt@@\n",
      "skills/": ""
    }
