{
  "type": "object",
  "properties": {
    "schema": {
      "const": "ecco.evidence/v1"
    },
    "env": {
      "type": "object",
      "properties": {
        "v": {
          "const": 0
        },
        "id": {
          "type": "string",
          "pattern": "^b3:[0-9a-f]{64}$"
        },
        "about": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "object"
        },
        "from": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{64}$"
        },
        "kind": {
          "enum": [
            "note",
            "claim",
            "release",
            "request",
            "finding",
            "proposal",
            "decision"
          ]
        },
        "prev": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sig": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{128}$"
        }
      },
      "required": [
        "v",
        "id",
        "about",
        "body",
        "from",
        "key",
        "kind",
        "prev",
        "to",
        "ts",
        "sig"
      ]
    },
    "profile": {
      "type": "object",
      "properties": {
        "v": {
          "const": 0
        },
        "name": {
          "type": "string"
        },
        "root": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{64}$"
        },
        "sig": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{128}$"
        },
        "delegations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "addr": {
                "type": "string"
              },
              "exp": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "key": {
                "type": "string",
                "pattern": "^ed25519:[0-9a-f]{64}$"
              },
              "kinds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sig": {
                "type": "string",
                "pattern": "^ed25519:[0-9a-f]{128}$"
              }
            },
            "required": [
              "addr",
              "exp",
              "key",
              "kinds",
              "sig"
            ]
          }
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "url"
            ]
          }
        }
      },
      "required": [
        "v",
        "name",
        "root",
        "sig",
        "delegations",
        "endpoints"
      ]
    },
    "receipt": {
      "type": "object",
      "properties": {
        "gseq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tseq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "id": {
          "type": "string"
        },
        "received_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "relay": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{64}$"
        },
        "sig": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{128}$"
        }
      },
      "required": [
        "gseq",
        "tseq",
        "id",
        "received_at",
        "relay",
        "sig"
      ]
    },
    "acceptance_sig": {
      "type": "string",
      "pattern": "^ed25519:[0-9a-f]{128}$"
    }
  },
  "required": [
    "schema",
    "env",
    "profile",
    "receipt",
    "acceptance_sig"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ecco portable acceptance evidence v1",
  "$comment": "Use the cryptographic verifier and independently pinned root/relay keys. This schema alone establishes no trust. Unknown v0 top-level fields are unauthenticated and excluded by typed verifiers."
}
